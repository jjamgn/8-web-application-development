<%- include('partials/header') %><div class="admin-layout"><%- include('partials/admin-nav') %><main class="admin-main"><span class="eyebrow">BẾP NHÀ / QUẢN TRỊ</span><div class="admin-heading"><div><h1>Quản lý <%= meta.label %></h1><p>Chăm chút từng chi tiết cho căn bếp của bạn.</p></div><a class="button primary" href="/admin/<%= kind %>/new">+ Thêm <%= meta.label %></a></div><div class="stats"><% [['dishes','Món ăn','◫'],['chefs','Đầu bếp','♧'],['ingredients','Nguyên liệu','❋']].forEach(([key,label,icon])=>{ %><a href="/admin/<%= key %>" class="stat <%= kind===key?'stat-active':'' %>"><span><%= label %></span><strong><%= counts[key] %></strong><i><%= icon %></i><small>Trong căn bếp của bạn</small></a><% }); %></div><% if(notice){ %><div class="notice" role="status"><%= notice %></div><% } %><section class="table-panel"><div class="table-panel-heading"><h2>Danh sách <%= meta.label %> <span><%= total %></span></h2></div><form class="admin-search" method="get"><input name="q" value="<%= q %>" placeholder="Tìm kiếm <%= meta.label %>..." aria-label="Tìm kiếm theo tên"><% if(kind==='dishes'){ %><select name="category" aria-label="Danh mục"><option value="">Tất cả danh mục</option><% categories.forEach(c=>{ %><option <%= category===c?'selected':'' %>><%= c %></option><% }); %></select><select name="available" aria-label="Trạng thái"><option value="">Tất cả trạng thái</option><option value="true" <%= available==='true'?'selected':'' %>>Đang phục vụ</option><option value="false" <%= available==='false'?'selected':'' %>>Tạm hết</option></select><% } %><button class="button primary">Tìm kiếm</button><a class="text-link" href="/admin/<%= kind %>">Đặt lại</a></form><div class="table-scroll"><table><thead><tr><th>ID</th><th><%= meta.title %></th><% if(kind==='dishes'){ %><th>Danh mục</th><th>Giá / phần</th><th>Trạng thái</th><% } else { %><th><%= kind==='chefs'?'Chuyên môn':'Đơn vị' %></th><% } %><th class="align-right">Thao tác</th></tr></thead><tbody><% items.forEach(item=>{ %><tr><td class="muted">#<%= item.id %></td><td><div class="table-name"><% if(kind==='dishes'){ %><img src="<%= imageUrl(item.imagePath) %>" alt=""><% } else { %><span class="table-avatar"><%= item.name[0] %></span><% } %><div><strong><%= item.name %></strong><% if(kind==='dishes'){ %><small><%= item.chef.name %></small><% } %></div></div></td><% if(kind==='dishes'){ %><td><%= item.category %></td><td class="price-cell"><%= money(item.price) %></td><td><span class="status <%= item.available?'':'off' %>"><%= item.available?'● Đang phục vụ':'● Tạm hết' %></span></td><% } else { %><td><%= kind==='chefs'?item.specialty:item.unit %></td><% } %><td><div class="row-actions"><% if(kind==='dishes'){ %><a href="/dishes/<%= item.id %>" aria-label="Xem <%= item.name %>">↗</a><% } %><a href="/admin/<%= kind %>/<%= item.id %>/edit">Sửa</a><a class="danger-link" href="/admin/<%= kind %>/<%= item.id %>/delete">Xóa</a></div></td></tr><% }); %><% if(!total){ %><tr><td colspan="6" class="empty-table">Chưa có kết quả phù hợp.</td></tr><% } %></tbody></table></div><%- include('partials/pagination') %></section><p class="admin-hint">Dữ liệu được xử lý trên máy chủ · Mọi thao tác xóa đều cần xác nhận</p></main></div><%- include('partials/footer') %>
