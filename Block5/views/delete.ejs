<%- include('partials/header') %><div class="admin-layout"><%- include('partials/admin-nav') %><main class="admin-main"><a class="back-link" href="/admin/<%= kind %>">← Danh sách <%= meta.label %></a><section class="confirm-panel"><span class="confirm-icon">!</span><span class="eyebrow">XÁC NHẬN THAO TÁC</span><h1>Xóa <%= meta.label %> này?</h1><p>Bạn đang xóa <strong><%= item.name %></strong>.<br>Dữ liệu đã xóa không thể khôi phục.</p><% if(error){ %><div class="alert" role="alert"><%= error %></div><% } %><form method="post" action="/admin/<%= kind %>/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="_method" value="DELETE"><div class="form-actions"><a class="button outline" href="/admin/<%= kind %>">Giữ lại</a><button class="button danger" type="submit">Xác nhận xóa</button></div></form></section></main></div><%- include('partials/footer') %>
