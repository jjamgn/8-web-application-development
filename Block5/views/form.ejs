<%- include('partials/header') %><div class="admin-layout"><%- include('partials/admin-nav') %><main class="admin-main"><a class="back-link" href="/admin/<%= kind %>">← Danh sách <%= meta.label %></a><h1><%= editing?'Chỉnh sửa':'Thêm' %> <%= meta.label %></h1><p class="muted">Thông tin chỉ được lưu sau khi bạn gửi biểu mẫu.</p><% if(error){ %><div class="alert" role="alert"><%= error %> <% if(kind==='dishes'){ %>Nếu có tải ảnh, vui lòng chọn lại ảnh trước khi gửi.<% } %></div><% } %><form method="post" action="/admin/<%= kind %><%= editing?'/'+values.id:'' %>" <%- kind==='dishes'?'enctype="multipart/form-data"':'' %> class="edit-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(editing){ %><input type="hidden" name="_method" value="PATCH"><% } %><div class="form-panel"><span class="eyebrow">THÔNG TIN <%= meta.title.toLocaleUpperCase('vi') %></span><label>Tên <%= meta.label %> <b>*</b><input name="name" value="<%= values.name||'' %>" required maxlength="<%= kind==='dishes'?160:120 %>"><% if(errors.name){ %><small class="field-error"><%= errors.name.join(' ') %></small><% } %></label><% if(kind==='dishes'){ %><label>Mô tả <b>*</b><textarea name="description" rows="5" required maxlength="5000"><%= values.description||'' %></textarea><% if(errors.description){ %><small class="field-error"><%= errors.description.join(' ') %></small><% } %></label><div class="form-columns"><label>Giá (VNĐ) <b>*</b><input name="price" type="number" min="1000" max="999999999" step="1" value="<%= values.price||'' %>" required><% if(errors.price){ %><small class="field-error"><%= errors.price.join(' ') %></small><% } %></label><label>Danh mục <b>*</b><select name="category" required><% categories.forEach(c=>{ %><option value="<%= c %>" <%= values.category===c?'selected':'' %>><%= c %></option><% }); %></select><% if(errors.category){ %><small class="field-error"><%= errors.category.join(' ') %></small><% } %></label></div><label>Đầu bếp <b>*</b><select name="chefId" required><option value="">Chọn đầu bếp</option><% chefs.forEach(c=>{ %><option value="<%= c.id %>" <%= Number(values.chefId)===c.id?'selected':'' %>><%= c.name %> — <%= c.specialty %></option><% }); %></select><% if(errors.chefId){ %><small class="field-error"><%= errors.chefId.join(' ') %></small><% } %></label><label class="checkbox-label"><input type="checkbox" name="available" <%= values.available?'checked':'' %>> Đang phục vụ món ăn này</label><% } else if(kind==='chefs'){ %><label>Chuyên môn <b>*</b><input name="specialty" value="<%= values.specialty||'' %>" required maxlength="200"><% if(errors.specialty){ %><small class="field-error"><%= errors.specialty.join(' ') %></small><% } %></label><label>Giới thiệu<textarea name="bio" rows="4" maxlength="3000"><%= values.bio||'' %></textarea><% if(errors.bio){ %><small class="field-error"><%= errors.bio.join(' ') %></small><% } %></label><% } else { %><label>Đơn vị <b>*</b><input name="unit" value="<%= values.unit||'' %>" placeholder="g, kg, ml, cái..." required maxlength="30"><% if(errors.unit){ %><small class="field-error"><%= errors.unit.join(' ') %></small><% } %></label><% } %></div><% if(kind==='dishes'){ %><div class="form-panel"><h2>Hình ảnh món ăn</h2><% if(values.imagePath){ %><img class="form-image" src="<%= imageUrl(values.imagePath) %>" alt="Ảnh hiện tại"><% } %><label>Chọn ảnh <%= editing?'thay thế':'món ăn *' %><input type="file" name="image" accept="image/png,image/jpeg,image/webp" <%= editing?'':'required' %>><small>PNG, JPEG, WebP · Tối đa 5 MB. Ảnh sẽ được lưu trên Supabase Storage.</small></label><h2>Nguyên liệu & định lượng</h2><p class="muted">Bỏ trống nguyên liệu không sử dụng. Số lượng tính cho một phần ăn.</p><div class="ingredient-inputs"><% ingredients.forEach(i=>{ const r=(values.ingredients||[]).find(r=>Number(r.ingredientId)===i.id); %><label><span><%= i.name %> <small>(<%= i.unit %>)</small></span><input name="qty_<%= i.id %>" type="number" step="0.01" min="0.01" max="99999999" value="<%= r?r.quantity:'' %>" aria-label="Số lượng <%= i.name %>" placeholder="—"></label><% }); %></div></div><% } %><div class="form-actions"><a class="button outline" href="/admin/<%= kind %>">Hủy</a><button class="button primary" type="submit"><%= editing?'Lưu thay đổi':'Thêm '+meta.label %> →</button></div></form></main></div><%- include('partials/footer') %>
