<%- include('partials/header') %><main class="login-page"><section class="login-card"><span class="eyebrow">CHÀO MỪNG TRỞ LẠI CĂN BẾP</span><h1>Đăng nhập quản trị</h1><p>Quản lý thực đơn và những người làm nên hương vị.</p><% if(error){ %><div class="alert" role="alert"><%= error %></div><% } %><form method="post" action="/admin/login"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Email<input type="email" name="email" autocomplete="username" value="<%= values.email||'' %>" required maxlength="200"></label><label>Mật khẩu<input type="password" name="password" autocomplete="current-password" required maxlength="200"></label><button class="button primary" type="submit">Vào căn bếp →</button></form><% if(demo){ %><a class="text-link" href="/admin/dishes">Xem thử giao diện quản trị →</a><% } %></section></main><%- include('partials/footer') %>
