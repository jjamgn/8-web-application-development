<% if(pages>1){ %><nav class="pagination" aria-label="Phân trang"><span>Trang <%= page %> / <%= pages %></span><div><% if(page>1){ %><a href="<%= link('page',page-1) %>" aria-label="Trang trước">←</a><% } %><% for(let n=Math.max(1,page-2);n<=Math.min(pages,page+2);n++){ %><a href="<%= link('page',n) %>" class="<%= n===page?'current':'' %>" <%- n===page?'aria-current="page"':'' %>><%= n %></a><% } %><% if(page<pages){ %><a href="<%= link('page',page+1) %>" aria-label="Trang sau">→</a><% } %></div><span><%= total %> kết quả</span></nav><% } %>
