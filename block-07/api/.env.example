PORT=3000
HOST=127.0.0.1
NODE_ENV=development
SPA_ORIGIN=http://localhost:5173
# Loopback aliases localhost/127.0.0.1 are accepted at the same protocol/port.
# API always uses Prisma/PostgreSQL; no read-only demo or SSR login settings.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Only required to resolve existing Storage images and run the original seed.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=dish-images
# local stores durable files in api/var/uploads; use supabase to store in the bucket above.
UPLOAD_STORAGE=local
PUBLIC_API_ORIGIN=http://127.0.0.1:3000
