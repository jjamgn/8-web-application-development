PORT=3000
NODE_ENV=development
# Only the public menu can be previewed in demo. Admin authentication stays protected.
DEMO_MODE=false
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# npm run admin:setup generates this locally. Keep it stable across restarts.
SESSION_SECRET=
# Optional separate HMAC secret for login counter keys, at least 32 characters.
AUTH_TOKEN_SECRET=
TRUST_PROXY_HOPS=0
# Existing restaurant image storage; the service key stays server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=dish-images
