PORT=3000
NODE_ENV=development
# Read-only preview. Set false after configuring the database, Storage and SMTP.
DEMO_MODE=true

# Replace every bracketed placeholder. URL-encode special password characters.
# Session-mode pooler supports IPv4 and can also be used for migrations.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DATABASE-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DATABASE-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=dish-images

# Generate at least 32 random characters. Keep stable across server restarts.
# Non-demo sessions and login failure counters are stored in PostgreSQL.
SESSION_SECRET=
# Number of trusted reverse-proxy hops; integer 0..5, default 0 (direct access).
# Configure only for the actual HTTPS proxy topology; never trust arbitrary headers.
TRUST_PROXY_HOPS=0
# Optional separate HMAC secret, at least 32 random characters.
# When empty, authentication token hashes use SESSION_SECRET.
AUTH_TOKEN_SECRET=

# Server invitation required to register a team account (at least 16 characters).
# Registration always creates role=viewer/status=pending, never grants admin.
# After email verification, a manager uses admin:promote for an existing account.
# npm run admin:setup generates this code and a session secret.
ADMIN_REGISTRATION_CODE=

# Trusted origin used to build verification/reset links. Production requires HTTPS.
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Require STARTTLS. Set false only for an explicit local SMTP test server.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# A mailbox or a display name plus mailbox, e.g. Bếp Nhà <no-reply@your-domain.vn>.
SMTP_FROM=
