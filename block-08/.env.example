PORT=3000
NODE_ENV=development
# Explicit read-only local preview. Set false after configuring Supabase.
DEMO_MODE=true

DATABASE_URL="postgresql://postgres.ynfmdzdexzxmcomdsbjw:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.ynfmdzdexzxmcomdsbjw:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
SUPABASE_URL="https://ynfmdzdexzxmcomdsbjw.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=dish-images
# Generate a long random value before using real administration.
SESSION_SECRET=
ADMIN_EMAIL=admin@bepnha.local
# Generate with: node --input-type=module -e "import bcrypt from 'bcryptjs'; console.log(await bcrypt.hash('YOUR_PASSWORD',12))"
ADMIN_PASSWORD_HASH=

# Shared email service: Gmail SMTP with an App Password (requires 2-Step Verification).
# Use an App Password here, not the normal Google account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Use the same Gmail address as SMTP_USER.
MAIL_FROM=

# Cloudflare Turnstile: the site key is public; keep the secret key server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostnames only, without scheme or port; these are for the local development widget.
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# Generate a separate random secret for OTP HMAC; keep stable across restarts.
OTP_SECRET=
