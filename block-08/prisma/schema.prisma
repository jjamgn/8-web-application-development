generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model Chef {
  id Int @id @default(autoincrement())
  name String @db.VarChar(120)
  bio String @default("")
  dishes Dish[]
  specialties ChefSpecialty[]
  createdAt DateTime @default(now())
}
model Specialty {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(80)
  chefs ChefSpecialty[]
}
model ChefSpecialty {
  chefId Int
  specialtyId Int
  chef Chef @relation(fields: [chefId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  @@id([chefId, specialtyId])
  @@index([specialtyId])
}
model Ingredient {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(120)
  unit String @db.VarChar(30)
  dishes DishIngredient[]
  createdAt DateTime @default(now())
}
model Dish {
  id Int @id @default(autoincrement())
  name String @db.VarChar(160)
  description String
  price Decimal @db.Decimal(12,0)
  category String @db.VarChar(60)
  available Boolean @default(true)
  imagePath String
  chefId Int
  chef Chef @relation(fields:[chefId], references:[id], onDelete:Restrict)
  ingredients DishIngredient[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([category,available])
  @@index([chefId])
}
model DishIngredient {
  dishId Int
  ingredientId Int
  quantity Decimal @db.Decimal(10,2)
  dish Dish @relation(fields:[dishId],references:[id],onDelete:Cascade)
  ingredient Ingredient @relation(fields:[ingredientId],references:[id],onDelete:Restrict)
  @@id([dishId,ingredientId])
}

enum UserStatus {
  pending
  active
}

model User {
  id              Int       @id @default(autoincrement())
  name            String    @default("") @db.VarChar(120)
  email           String    @unique @db.VarChar(254)
  passwordHash    String    @db.VarChar(255)
  emailVerifiedAt DateTime?
  role            String    @default("viewer")
  status          UserStatus @default(pending)
  passwordVersion Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  sessions        Session[]
}

model Session {
  sid       String   @id @db.VarChar(128)
  sess      Json
  userId    Int?
  expiresAt DateTime
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  key             String   @id @db.VarChar(80)
  failures        Int      @default(0)
  windowStartedAt DateTime
  lockedUntil     DateTime?
  updatedAt       DateTime @updatedAt

  @@index([lockedUntil])
}
