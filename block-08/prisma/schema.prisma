generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  pending
  active
}

model User {
  id                Int                @id @default(autoincrement())
  name              String             @default("") @db.VarChar(120)
  /// Normalize email before saving so the unique constraint also prevents case variants.
  email             String             @unique @db.VarChar(254)
  passwordHash      String             @db.VarChar(255)
  /// Assigned by the server; registration must never accept a role from the form.
  role              String             @default("viewer")
  status            UserStatus         @default(pending)
  /// Null until the email OTP has been verified successfully.
  emailVerifiedAt   DateTime?
  createdAt         DateTime           @default(now())
  passwordVersion   Int                @default(0)
  updatedAt         DateTime           @default(now()) @updatedAt
  emailVerification EmailVerification?
  passwordResetTokens PasswordResetToken[]
  sessions          Session[]
}

model EmailVerification {
  /// One current OTP per user; resending replaces the previous challenge.
  userId     Int      @id
  /// Store only a keyed digest or password hash, never the plaintext OTP.
  otpHash    String   @db.VarChar(255)
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  /// Set when consumed; retain the record so the same OTP cannot be used again.
  usedAt     DateTime?
  /// Five failed attempts lock verification and resending for fifteen minutes.
  lockedUntil DateTime?
  sendWindowStartedAt DateTime @default(now())
  sendCount  Int      @default(1)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Session {
  sid       String   @id @db.VarChar(128)
  sess      Json
  userId    Int?
  expiresAt DateTime
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  key             String   @id @db.VarChar(80)
  failures        Int      @default(0)
  windowStartedAt DateTime
  lockedUntil     DateTime?
  updatedAt       DateTime @updatedAt

  @@index([lockedUntil])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    Int
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Chef {
  id Int @id @default(autoincrement())
  name String @db.VarChar(120)
  specialty String @db.VarChar(200)
  bio String @default("")
  dishes Dish[]
  createdAt DateTime @default(now())
}
model Ingredient {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(120)
  unit String @db.VarChar(30)
  dishes DishIngredient[]
  createdAt DateTime @default(now())
}
model Dish {
  id Int @id @default(autoincrement())
  name String @db.VarChar(160)
  description String
  price Decimal @db.Decimal(12,0)
  category String @db.VarChar(60)
  available Boolean @default(true)
  imagePath String
  chefId Int
  chef Chef @relation(fields:[chefId], references:[id], onDelete:Restrict)
  ingredients DishIngredient[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([category,available])
  @@index([chefId])
}
model DishIngredient {
  dishId Int
  ingredientId Int
  quantity Decimal @db.Decimal(10,2)
  dish Dish @relation(fields:[dishId],references:[id],onDelete:Cascade)
  ingredient Ingredient @relation(fields:[ingredientId],references:[id],onDelete:Restrict)
  @@id([dishId,ingredientId])
}
