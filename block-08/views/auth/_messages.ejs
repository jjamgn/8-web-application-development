<% if (typeof error !== 'undefined' && error) { %><div class="alert" role="alert"><%= error %></div><% } %>
<% if (typeof notice !== 'undefined' && notice) { %><div class="notice" role="status"><%= notice %></div><% } %>
<% if (demo) { %><p class="auth-demo">Bạn đang ở bản xem thử. Các thao tác tài khoản đội ngũ sẽ khả dụng khi ứng dụng được kết nối dữ liệu.</p><% } %>
