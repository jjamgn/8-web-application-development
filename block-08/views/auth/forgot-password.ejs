<%- include('../partials/header') %>
<main class="auth-page">
  <%- include('_intro', { introTitle: 'Trở lại với công việc của căn bếp.', introCopy: 'Khôi phục quyền truy cập trang quản lý Bếp Nhà bằng email của tài khoản quản trị đã đăng ký.' }) %>
  <section class="auth-card" aria-labelledby="auth-title">
    <span class="eyebrow">MÌNH BẮT ĐẦU LẠI NHÉ</span>
    <h1 id="auth-title">Quên mật khẩu quản trị</h1>
    <p class="auth-lead">Nhập email quản trị để nhận hướng dẫn đặt lại mật khẩu.</p>
    <%- include('_messages') %>
    <form class="auth-form" method="post" action="/auth/forgot-password">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="auth-field"><label for="email">Địa chỉ email đã đăng ký</label><input id="email" type="email" name="email" autocomplete="email" value="<%= values.email || '' %>" required maxlength="254" aria-invalid="<%= errors.email ? 'true' : 'false' %>" <%- errors.email ? 'aria-describedby="email-error"' : '' %>><%- include('_field-error', { field: 'email' }) %></div>
      <%- include('_captcha', { refreshPath: '/auth/forgot-password' }) %>
      <button class="button primary auth-submit" type="submit">Gửi hướng dẫn</button>
    </form>
    <p class="auth-switch"><a href="/auth/login">Quay lại đăng nhập quản trị</a></p>
  </section>
</main>
<%- include('../partials/footer') %>
