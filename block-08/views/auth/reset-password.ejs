<%- include('../partials/header') %>
<main class="auth-page">
  <%- include('_intro', { introTitle: 'Bảo vệ tài khoản, an tâm vào bếp.', introCopy: 'Chọn mật khẩu mới cho tài khoản quản trị trước khi tiếp tục quản lý nhà hàng Bếp Nhà.' }) %>
  <section class="auth-card" aria-labelledby="auth-title">
    <span class="eyebrow">CHĂM CHÚT TÀI KHOẢN CỦA BẠN</span>
    <h1 id="auth-title">Đặt lại mật khẩu quản trị</h1>
    <p class="auth-lead">Nhập mật khẩu mới, sau đó đăng nhập lại vào trang quản trị.</p>
    <%- include('_messages') %>
    <form class="auth-form" method="post" action="/auth/reset-password">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="token" value="<%= values.token || '' %>">
      <%- include('_field-error', { field: 'token' }) %>
      <div class="auth-field"><label for="password">Mật khẩu mới</label><input id="password" type="password" name="password" autocomplete="new-password" required minlength="8" maxlength="72" aria-invalid="<%= errors.password ? 'true' : 'false' %>" aria-describedby="password-help<%= errors.password ? ' password-error' : '' %>"><small class="auth-field-help" id="password-help">Sử dụng ít nhất 8 ký tự; tránh mật khẩu quá dài.</small><%- include('_field-error', { field: 'password' }) %></div>
      <div class="auth-field"><label for="confirmPassword">Nhập lại mật khẩu mới</label><input id="confirmPassword" type="password" name="confirmPassword" autocomplete="new-password" required minlength="8" maxlength="72" aria-invalid="<%= errors.confirmPassword ? 'true' : 'false' %>" <%- errors.confirmPassword ? 'aria-describedby="confirmPassword-error"' : '' %>><%- include('_field-error', { field: 'confirmPassword' }) %></div>
      <button class="button primary auth-submit" type="submit">Lưu mật khẩu mới <span aria-hidden="true">→</span></button>
    </form>
    <p class="auth-switch"><a href="/auth/forgot-password">Yêu cầu liên kết đặt lại mới</a></p>
  </section>
</main>
<%- include('../partials/footer') %>
