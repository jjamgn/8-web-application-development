<article class="dish-card"><a class="dish-image" href="/dishes/<%= dish.id %>"><img src="<%= imageUrl(dish.imagePath) %>" alt="<%= dish.name %>" loading="lazy"><span class="card-category"><%= dish.category %></span><% if(!dish.available) { %><span class="unavailable">Tạm hết món</span><% } %></a><div class="card-body"><div class="card-title"><h3><a href="/dishes/<%= dish.id %>"><%= dish.name %></a></h3><span><%= money(dish.price) %></span></div><p><%= dish.description %></p><div class="card-bottom"><span><span aria-hidden="true">♧</span> <%= dish.chef?.name || 'Đầu bếp Bếp Nhà' %></span><a href="/dishes/<%= dish.id %>">Khám phá món</a></div></div></article>
