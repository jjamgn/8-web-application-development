PORT=3000
HOST=127.0.0.1
NODE_ENV=development
SPA_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Exact allowlist; use the same hostname for SPA and API.
WEB_ORIGIN=http://localhost:5173
# Set two DIFFERENT random secrets locally, at least 32 bytes each.
JWT_SECRET=
JWT_ISSUER=bep-nha-api
JWT_AUDIENCE=bep-nha-web
AUTH_TOKEN_SECRET=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Only required to resolve existing Storage images and run the original seed.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=dish-images
