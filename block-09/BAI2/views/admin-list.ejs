<%- include('partials/header') %>
<% const role = currentUser?.role || 'viewer'; %>
<% const canCreate = role === 'admin' || (role === 'editor' && kind === 'dishes' && currentUser?.chefId); %>
<div class="admin-layout">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <span class="eyebrow">BẾP NHÀ / QUẢN TRỊ</span>
    <div class="admin-heading">
      <div><h1>Quản lý <%= meta.label %></h1><p>Chăm chút từng chi tiết cho căn bếp của bạn.</p></div>
      <% if (canCreate) { %><a class="button primary" href="/admin/<%= kind %>/new">+ Thêm <%= meta.label %></a><% } %>
    </div>
    <div class="stats">
      <% [['dishes','Món ăn','◫'],['chefs','Đầu bếp','♧'],['ingredients','Nguyên liệu','❋']].forEach(([key,label,icon]) => { %>
        <a href="/admin/<%= key %>" class="stat <%= kind === key ? 'stat-active' : '' %>"><span><%= label %></span><strong><%= counts[key] %></strong><i><%= icon %></i><small>Trong căn bếp của bạn</small></a>
      <% }); %>
    </div>
    <% if (notice) { %><div class="notice" role="status"><%= notice %></div><% } %>
    <section class="table-panel">
      <div class="table-panel-heading"><h2>Danh sách <%= meta.label %> <span><%= total %></span></h2></div>
      <form class="admin-search" method="get">
        <input name="q" value="<%= q %>" placeholder="Tìm kiếm <%= meta.label %>..." aria-label="Tìm kiếm theo tên">
        <% if (kind === 'dishes') { %>
          <select name="category" aria-label="Danh mục"><option value="">Tất cả danh mục</option><% categories.forEach(c => { %><option <%= category === c ? 'selected' : '' %>><%= c %></option><% }); %></select>
          <select name="available" aria-label="Phục vụ"><option value="">Tất cả mức phục vụ</option><option value="true" <%= available === 'true' ? 'selected' : '' %>>Đang phục vụ</option><option value="false" <%= available === 'false' ? 'selected' : '' %>>Tạm hết</option></select>
        <% } %>
        <button class="button primary">Tìm kiếm</button><a class="text-link" href="/admin/<%= kind %>">Đặt lại</a>
      </form>
      <div class="table-scroll"><table>
        <thead><tr><th>ID</th><th><%= meta.title %></th><% if (kind === 'dishes') { %><th>Danh mục</th><th>Giá / phần</th><th>Công bố</th><th>Phục vụ</th><% } else { %><th><%= kind === 'chefs' ? 'Chuyên môn' : 'Đơn vị' %></th><% } %><th class="align-right">Thao tác</th></tr></thead>
        <tbody>
          <% items.forEach(item => {
            const canEdit = role === 'admin' || (role === 'editor' && kind === 'dishes' && item.chefId === currentUser?.chefId && item.status === 'draft');
            const canDelete = role === 'admin';
          %>
            <tr>
              <td class="muted">#<%= item.id %></td>
              <td><div class="table-name"><% if (kind === 'dishes') { %><img src="<%= imageUrl(item.imagePath) %>" alt=""><% } else { %><span class="table-avatar"><%= item.name[0] %></span><% } %><div><strong><%= item.name %></strong><% if (kind === 'dishes') { %><small><%= item.chef.name %></small><% } %></div></div></td>
              <% if (kind === 'dishes') { %>
                <td><%= item.category %></td><td class="price-cell"><%= money(item.price) %></td>
                <td><span class="status <%= item.status === 'draft' ? 'off' : '' %>"><%= item.status === 'draft' ? 'Bản nháp' : 'Đã công bố' %></span></td>
                <td><span class="status <%= item.available ? '' : 'off' %>"><%= item.available ? 'Đang phục vụ' : 'Tạm hết' %></span></td>
              <% } else { %><td><%= kind === 'chefs' ? item.specialty : item.unit %></td><% } %>
              <td><div class="row-actions">
                <% if (kind === 'dishes' && item.status !== 'draft') { %><a href="/dishes/<%= item.id %>" aria-label="Xem <%= item.name %>">Xem</a><% } %>
                <% if (canEdit) { %><a href="/admin/<%= kind %>/<%= item.id %>/edit">Sửa</a><% } %>
                <% if (canDelete) { %><a class="danger-link" href="/admin/<%= kind %>/<%= item.id %>/delete">Xóa</a><% } %>
                <% if (!canEdit && !canDelete && (kind !== 'dishes' || item.status === 'draft')) { %><span class="muted">Chỉ xem</span><% } %>
              </div></td>
            </tr>
          <% }); %>
          <% if (!total) { %><tr><td colspan="<%= kind === 'dishes' ? 7 : 4 %>" class="empty-table">Chưa có kết quả phù hợp.</td></tr><% } %>
        </tbody>
      </table></div>
      <%- include('partials/pagination') %>
    </section>
    <p class="admin-hint">Quyền thao tác được kiểm tra trên máy chủ khi bạn mở form và gửi yêu cầu.</p>
  </main>
</div>
<%- include('partials/footer') %>
