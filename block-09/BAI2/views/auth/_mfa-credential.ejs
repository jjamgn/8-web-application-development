<div class="auth-field">
  <label for="<%= fieldPrefix %>-method">Cách xác minh</label>
  <select id="<%= fieldPrefix %>-method" name="method" required>
    <option value="totp" <%= selectedMethod === 'recovery' ? '' : 'selected' %>>Mã 6 số từ ứng dụng</option>
    <option value="recovery" <%= selectedMethod === 'recovery' ? 'selected' : '' %>>Mã dự phòng</option>
  </select>
</div>
<div class="auth-field">
  <label for="<%= fieldPrefix %>-code">Mã xác minh</label>
  <input id="<%= fieldPrefix %>-code" name="code" type="text" inputmode="text" autocomplete="one-time-code" spellcheck="false" autocapitalize="characters" required maxlength="40" aria-describedby="<%= fieldPrefix %>-code-help">
  <small class="auth-field-help" id="<%= fieldPrefix %>-code-help">Mã ứng dụng gồm 6 chữ số. Nếu không còn điện thoại, chọn mã dự phòng đã lưu.</small>
</div>
