generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PhotoStatus {
  PUBLISHED
  DELETING
}

enum CleanupStatus {
  PENDING
  DONE
}

enum PhotoKind {
  PHOTO
  AVATAR
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(254)
  passwordHash String
  createdAt    DateTime  @default(now())
  bio          String    @default("") @db.VarChar(300)
  avatarPhotoId String?   @db.Uuid
  avatarPhoto  Photo?    @relation("AvatarPhoto", fields: [avatarPhotoId], references: [id], onDelete: SetNull)
  favorites    Favorite[]
  collections  Collection[]
  following    Follow[]  @relation("Follower")
  followers    Follow[]  @relation("Followee")
  photos       Photo[]   @relation("Uploads")
  sessions     Session[]
}

model Session {
  sid       String   @id
  userId    String?  @db.Uuid
  data      Json
  expiresAt DateTime
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Photo {
  id         String         @id @default(uuid()) @db.Uuid
  uploaderId String         @db.Uuid
  title      String         @db.VarChar(120)
  alt        String         @db.VarChar(300)
  width      Int
  height     Int
  status     PhotoStatus    @default(PUBLISHED)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  kind       PhotoKind      @default(PHOTO)
  avatarFor  User[]          @relation("AvatarPhoto")
  favorites  Favorite[]
  collectionItems CollectionItem[]
  uploader   User           @relation("Uploads", fields: [uploaderId], references: [id], onDelete: Restrict)
  variants   PhotoVariant[]

  @@index([status, createdAt, id])
  @@index([uploaderId])
}

model PhotoVariant {
  id            String       @id @default(uuid()) @db.Uuid
  photoId       String       @db.Uuid
  width         Int
  height        Int
  mime          String       @default("image/webp")
  bytes         Int
  sha256        String       @db.VarChar(64)
  chunkSize     Int          @default(1048576)
  chunkCount    Int
  storagePrefix String       @unique
  photo         Photo        @relation(fields: [photoId], references: [id], onDelete: Cascade)
  chunks        PhotoChunk[]

  @@unique([photoId, width])
}

model PhotoChunk {
  id         String       @id @default(uuid()) @db.Uuid
  variantId  String       @db.Uuid
  partNumber Int
  offset     Int
  bytes      Int
  sha256     String       @db.VarChar(64)
  storageKey String       @unique
  variant    PhotoVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, partNumber])
}

model StorageCleanupTask {
  id            String        @id @default(uuid()) @db.Uuid
  storageKey    String        @unique
  status        CleanupStatus @default(PENDING)
  attempts      Int           @default(0)
  lastErrorCode String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
}

model Favorite {
  userId String @db.Uuid
  photoId String @db.Uuid
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  @@id([userId, photoId])
  @@index([photoId])
}
model Follow {
  followerId String @db.Uuid
  followeeId String @db.Uuid
  createdAt DateTime @default(now())
  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)
  @@id([followerId, followeeId])
  @@index([followeeId])
}
model Collection {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  title String @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items CollectionItem[]
  @@index([ownerId, createdAt])
}
model CollectionItem {
  collectionId String @db.Uuid
  photoId String @db.Uuid
  createdAt DateTime @default(now())
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  @@id([collectionId, photoId])
  @@index([photoId])
}
